{
  "name": "cms-hpt-tracker",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "description": "Finds every US hospital's CMS price-transparency file and reports who publishes, who is stale, and who blocks automated access.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "seed": "node scripts/hpt/run.js seed",
    "pointers": "node scripts/hpt/run.js pointers",
    "match": "node scripts/hpt/run.js match",
    "dates": "node scripts/hpt/run.js dates",
    "compliance": "node scripts/hpt/run.js compliance",
    "gaps": "node scripts/hpt/run.js gaps",
    "report": "node scripts/hpt/run.js report",
    "audit": "node scripts/hpt/run.js audit",
    "recover:llm": "node scripts/hpt/run.js recover --llm",
    "outreach:prep": "node scripts/hpt/outreach-prep.js",
    "geocode": "node scripts/hpt/geocode.js",
    "export:pointers": "node scripts/export-pointers.js",
    "export:pointers:check": "node scripts/export-pointers.js --check",
    "build": "npm run protect:contacts && node scripts/build-glossary.js && node scripts/build-tracker.js && npm run protect:contacts && npm run check:contacts-private",
    "protect:contacts": "node scripts/protect-public-contacts.js",
    "check:contacts-private": "node scripts/protect-public-contacts.js --check",
    "serve": "node scripts/site-server.js",
    "serve:outreach": "node scripts/outreach-server.js",
    "outreach": "node scripts/outreach-cli.js",
    "redact": "node scripts/outreach-redact.js",
    "find:domains": "node scripts/hpt/find-domains.js",
    "find:domains:trial": "node scripts/hpt/find-domains.js --sources=prior,pointers,wikidata,osm,heuristic --queue=missing,stale --sample=100 --sample-mode=stratified --seed=20260903",
    "find:domains:relationships": "node scripts/hpt/find-domains.js --sources=cms-relations,nppes,siblings,contacts,irs990 --queue=missing,stale,name,blocked --llm-name-match --model=z-ai/glm-5.3-flash",
    "find:domains:glm": "node scripts/hpt/find-domains.js --sources=nppes,llm-domain --queue=missing --llm-name-match --model=z-ai/glm-5.3-flash",
    "find:domains:serper": "node scripts/hpt/find-domains.js --sources=search --queue=missing --sample=579 --sample-mode=stratified --seed=20260903 --search-limit=579 --search-candidates=1 --max-candidates=1 --search-concurrency=5 --concurrency=4 --stage-dir=data/hpt-audit/.domain-discovery/serper-579 --llm-name-match --model=z-ai/glm-5.3-flash",
    "hpt:domain-observations": "node scripts/hpt/export-domain-observations.js",
    "hpt:review-569:deepen": "node scripts/hpt/deepen-candidate-identities.js worklist && node scripts/hpt/deepen-candidate-identities.js analyze && node scripts/hpt/deepen-candidate-identities.js decide",
    "hpt:review-569:export": "node scripts/hpt/review-domain-cohort.js export",
    "hpt:review-569:finalize": "node scripts/hpt/finalize-review-569.js",
    "hpt:review-569:refresh-mrfs": "node scripts/hpt/refresh-review-569-mrfs.js",
    "hpt:review-569:retry-pointers": "node scripts/hpt/review-domain-cohort.js official-retry",
    "obfuscate:pointers": "node scripts/hpt/obfuscate-pointers.js",
    "check:pointers-private": "node scripts/hpt/obfuscate-pointers.js --check",
    "hpt:pointers:corpus": "node scripts/hpt/pointer-corpus.js",
    "hpt:audit:corpus-index": "node scripts/hpt/audit-corpus-state-index.js",
    "hpt:audit:corpus-ccns": "node scripts/hpt/build-corpus-index-ccn-worklist.js",
    "hpt:pointers:headers": "node scripts/hpt/probe-pointer-corpus.js --input=cms_data/hpt/pointer-corpus/cms_hpt_entries.csv --out=cms_data/hpt/nationwide-verification/mrf-headers.csv --cache=cms_data/hpt/nationwide-verification/mrf-header-cache.json --concurrency=30 --per-host=4",
    "hpt:verify:nationwide": "node scripts/hpt/build-nationwide-verification.js",
    "hpt:verify:reconcile-all": "node scripts/hpt/rebuild-reviewed-artifacts.js",
    "hpt:verify:queues": "node scripts/hpt/build-nationwide-queues.js",
    "hpt:verify:recovered-shortlist": "node scripts/hpt/build-recovered-unresolved-shortlist.js",
    "hpt:verify:unresolved-worklist": "node scripts/hpt/build-unresolved-investigation-worklist.js",
    "hpt:verify:address-variants": "node scripts/hpt/build-address-variant-alias-candidates.js",
    "hpt:audit:unresolved-support": "node scripts/hpt/audit-unresolved-support.js",
    "hpt:verify:standing-worklist": "node scripts/hpt/build-standing-evidence-followup-worklist.js",
    "hpt:verify:same-campus-worklist": "node scripts/hpt/build-same-campus-ccn-worklist.js",
    "hpt:review:priority-one-cms-enrollments": "node scripts/hpt/review-priority-one-cms-enrollments.js",
    "hpt:verify:supported-worklist": "node scripts/hpt/build-supported-uncertainty-worklist.js",
    "hpt:verify:proof-retries": "node scripts/hpt/build-byte-proof-retry-ledger.js",
    "hpt:verify:capture-alias-proof": "node scripts/hpt/capture-reviewed-alias-pointer-proof.js",
    "hpt:verify:apply-alias-proof": "node scripts/hpt/apply-reviewed-alias-pointer-proof.js",
    "hpt:audit:omh-multisection": "node scripts/hpt/audit-omh-multisection-file.js",
    "hpt:verify:apply-omh-multisection-audit": "node scripts/hpt/apply-omh-multisection-file-audit.js",
    "hpt:verify:record-search": "node scripts/hpt/nationwide-search-review.js",
    "hpt:verify:web-search": "node scripts/hpt/nationwide-web-discovery.js search",
    "hpt:verify:web-adjudicate": "node scripts/hpt/nationwide-web-discovery.js adjudicate",
    "hpt:direct-mrf:prepare": "node scripts/hpt/direct-mrf-corpus.js",
    "hpt:direct-mrf:headers": "node scripts/hpt/probe-pointer-corpus.js --input=cms_data/hpt/new/direct_mrf_entries.csv --out=cms_data/hpt/new/direct_mrf_headers.csv --cache=cms_data/hpt/direct-mrf/mrf-header-cache.json --concurrency=30 --per-host=4",
    "hpt:direct-mrf": "npm run hpt:direct-mrf:prepare && npm run hpt:direct-mrf:headers",
    "hpt:combine-corpus": "node scripts/hpt/combine-corpus.js",
    "hpt:curl:evidence": "node scripts/hpt/curl-evidence.js",
    "hpt:interventions": "node scripts/hpt/build-interventions.js",
    "test": "node --test --test-concurrency=1 scripts/hpt/test/*.test.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5"
  }
}
