node_modules/
.DS_Store
*.log

# Private fieldwork log - never publish. cms_data/outreach.public.json (generated
# by scripts/outreach-redact.js, auto-refreshed on every store save) is the
# shareable copy: emails masked, person names replaced.
cms_data/outreach.json
cms_data/outreach.backup.json
# Real staff names to mask - publishing the keys would defeat the masking.
# Copy redact-names.example.json to redact-names.json and fill it in locally.
cms_data/redact-names.json

# Personal tooling config. The outreach skill itself is public (sanitized);
# launch.json is local editor setup.
.claude/launch.json
.claude/settings.local.json
.zcode/

# Working files for the outreach draft queue and LLM recovery. These hold
# unreviewed drafts and scraped hospital contact addresses; the reviewed
# fieldwork is what goes into cms_data/outreach.json via the outreach skill.
cms_data/hpt/outreach_queue.csv
cms_data/hpt/outreach_prep.json
cms_data/hpt/recovered.csv
cms_data/hpt/recovered_mrfs.json
cms_data/hpt/footer_mrfs.json
cms_data/hpt/pointers/
cms_data/hpt/pointers.json
cms_data/hpt/mrf_dates.json
# Legacy working-copy report. The publishable pointer archive, its audit report,
# and its intentionally shared key live under data/hpt-audit/.
cms_data/hpt/pointer-obfuscation.json
# Disposable staging derived from external link exports. Only the independently
# fetched evidence and verified-domain CSVs are durable tracker outputs.
cms_data/hpt/external_link_candidates.csv
cms_data/hpt/external_link_unmapped.csv
cms_data/hpt/external_link_checks.json
# Raw cms-hpt.txt corpus, resumable crawl state, and normalized CSV export.
cms_data/hpt/pointer-corpus/
cms_data/hpt/external-pointer-corpus/
# Resumable direct-MRF header cache. Reviewable CSV evidence stays outside it.
cms_data/hpt/direct-mrf/
# Working copies regenerated from the public snapshot by import-corpus.js /
# run.js compliance|gaps|dates during a refresh. data/hpt-audit/ holds the
# publishable outputs; these are never the source of truth.
cms_data/hpt/manifest.csv
cms_data/hpt/manifest.json
cms_data/hpt/compliance.csv
cms_data/hpt/gaps.csv
cms_data/hpt/gaps_*.csv
cms_data/hpt/corpus_import.json
# One-off refresh scripts and session logs (evidence summaries that matter are
# banked under data/hpt-audit/rechecks/<date>/ instead).
cms_data/hpt/refresh-*/

# Credentials. scripts/hpt/run.js loads .env first, then .env.local on top.
# Nothing here encrypts either one: there is no .gitattributes, no git-crypt
# filter and no git-crypt binary, whatever run.js's inherited comment says. A
# committed .env would go up in the clear, so ignore both and commit only the
# example.
.env*
!.env.example
# Working files from find-domains.js / outreach-prep.js run against the audit
# snapshot. Unreviewed candidate domains and draft emails, not results.
data/hpt-audit/found_domains.csv
data/hpt-audit/find_domains.json
data/hpt-audit/gaps_no_domain.csv
data/hpt-audit/outreach_queue.csv
data/hpt-audit/outreach_prep.json
data/hpt-audit/manifest.json
# Resumable website-discovery candidates, source caches, evidence, and protected
# pointer snapshots. Only an explicitly promoted result becomes public data.
data/hpt-audit/.domain-discovery/
# Investigation retrieval objects retain raw pointer contacts and response headers.
data/hpt-audit/rechecks/2026-09-09/investigation/retrieval-results.json
data/hpt-audit/rechecks/2026-09-09/investigation/targeted-retrievals.json
# Publisher replies may contain personal signatures and contact details.
data/hpt-audit/rechecks/2026-09-09/investigation/publisher-responses.json
